# Acrescente estes valores ao .env existente de Sete Lagoas no servidor.
# Este modelo não contém credenciais e não substitui o .env completo da instância.
# 7lagoas e sete-lagoas habilitam as mesmas funcionalidades. Mantenha o valor existente.
MUNICIPIO=7lagoas

# Dias úteis: 1=segunda, 5=sexta. Horários no fuso America/Sao_Paulo.
BUSINESS_DAY_START=1
BUSINESS_DAY_END=5
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=16:30

# Use false para desabilitar o atendimento aos sábados.
BUSINESS_SATURDAY_ENABLED=true
BUSINESS_SATURDAY_START=07:00
BUSINESS_SATURDAY_END=18:30

# Após a publicação, configure CHATBOT_IMAGE com a tag sha-<commit> informada
# pelo GitHub Actions para atualizar somente a instância desejada.
