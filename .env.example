# =============================================================================
# CHATBOT AUTOATENDIMENTO - SAAE FORMIGA
# Copie este arquivo para .env e preencha os valores
# =============================================================================

PORT=3000

# Identificador do município (usado no nome do container Docker)
MUNICIPIO=formiga

# =============================================================================
# SUPABASE (banco de dados e autenticação)
# =============================================================================
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SEU_SERVICE_ROLE_KEY

# =============================================================================
# Z-API (instância WhatsApp)
# =============================================================================
ZAPI_BASE_URL=https://api.z-api.io
ZAPI_INSTANCE_ID=SEU_INSTANCE_ID
ZAPI_TOKEN=SEU_TOKEN
ZAPI_CLIENT_TOKEN=SEU_CLIENT_TOKEN

# =============================================================================
# WHATSAPP CLOUD API OFICIAL (Meta) — opcional
# Define WHATSAPP_PROVIDER=meta pra essa instância usar a API oficial da Meta
# em vez do Z-API. Precisa de WABA + número dedicado configurados no Meta
# Business Manager. Deixe em branco/zapi pra manter o comportamento atual.
# =============================================================================
WHATSAPP_PROVIDER=zapi
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_API_VERSION=v21.0

# =============================================================================
# SEGURANÇA DO PAINEL (rotas /api/* do painel de atendimento e BI)
# Sem essa variável, as rotas ficam abertas (fail-open) para não quebrar
# instâncias antigas. Defina uma chave forte para exigir autenticação.
# Gerar uma chave: openssl rand -hex 32
# =============================================================================
API_SECRET=

# =============================================================================
# ATENDIMENTO HUMANO VIA LIGAÇÃO (opcional, por entidade)
# Se ativado, "Falar com atendente" mostra um botão de ligação em vez de abrir
# ticket de atendimento humano pelo WhatsApp. Só dentro do horário comercial.
# =============================================================================
HUMAN_HANDOFF_CALL_ENABLED=false
HUMAN_HANDOFF_CALL_PHONE=
HUMAN_HANDOFF_CALL_MESSAGE=

# =============================================================================
# SESSÃO
# =============================================================================
SESSION_MAX_INACTIVITY_MINUTES=15
SESSION_MAX_AGE_HOURS=24

# =============================================================================
# SMTP (envio de OTP por e-mail)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=SEU_EMAIL@gmail.com
SMTP_PASS=SUA_SENHA_DE_APP
SMTP_FROM="Atendimento SAAE Formiga: Autoatendimento <SEU_EMAIL@gmail.com>"

# =============================================================================
# OTP (código de verificação)
# =============================================================================
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MOCK=false

# =============================================================================
# LINK API - GestCom (integração principal com o sistema do SAAE)
# Solicitar URL e token ao suporte da GestCom para o município de Formiga
# =============================================================================
LINK_API_BASE_URL=https://ms.formiga.sistemagestcom.com.br/api/integracao/link
LINK_API_TOKEN=SEU_TOKEN_GESTCOM
LINK_API_MOCK=false

# ID de demonstração (usado apenas para testes)
DEMO_ID_ELETRONICO=SEU_ID_DEMO

# =============================================================================
# TELEFONE DA ENTIDADE (SAAE Formiga)
# Formato: DDI + DDD + número, sem espaços (ex: 5537999999999)
# =============================================================================
ENTIDADE_PHONE_NUMBER=5537XXXXXXXXX

# =============================================================================
# ATENDIMENTO PRESENCIAL - SAAE Formiga
# Preencher com o endereço real do SAAE de Formiga
# Para obter coordenadas: abrir Google Maps, clicar no local, copiar lat/lng
# =============================================================================
ATENDIMENTO_MAPS_URL=https://www.google.com/maps/dir/?api=1&destination=LAT,LNG
ATENDIMENTO_MAPS_TITLE=SAAE Formiga - Atendimento
ATENDIMENTO_MAPS_ADDRESS=Rua XXXXX, NNN - Centro, Formiga - MG, XXXXX-XXX
ATENDIMENTO_MAPS_LATITUDE=-20.XXXX
ATENDIMENTO_MAPS_LONGITUDE=-45.XXXX
ATENDIMENTO_MAPS_DESCRIPTION=Clique no link acima para abrir o Google Maps com a rota até o local de atendimento.

# =============================================================================
# MÍDIA (áudio de boas-vindas, menu e vídeo tutorial)
# Pode ser URL pública (https://...) ou base64 (data:audio/mpeg;base64,...)
# =============================================================================
WELCOME_AUDIO_URL=https://SEU_SERVIDOR/audio/welcome.mp3
MENU_AUDIO_URL=https://SEU_SERVIDOR/audio/menu.mp3
VIDEO_TUTORIAL_URL=https://SEU_SERVIDOR/video/tutorial.mp4
VIDEO_TUTORIAL_CAPTION=Aprenda como usar o autoatendimento do SAAE Formiga
VIDEO_TUTORIAL_INTRO=Este vídeo mostra como aproveitar todos os recursos do autoatendimento.
